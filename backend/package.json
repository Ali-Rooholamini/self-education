{
  "name": "@self-education/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run db:setup",
    "dev": "node --env-file-if-exists=.env --run start:dev",
    "start:dev": "nest start --watch",
    "build": "npm run db:generate && nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run db:generate && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "db:setup": "npm run db:generate && npm run db:migrate",
    "db:generate": "node --env-file-if-exists=.env scripts/prisma.mjs generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma.mjs migrate deploy",
    "db:status": "node --env-file-if-exists=.env scripts/prisma.mjs migrate status",
    "db:migration:create": "node --env-file-if-exists=.env scripts/prisma.mjs migrate dev --create-only",
    "db:studio": "node --env-file-if-exists=.env scripts/prisma.mjs studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "prisma": "7.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
